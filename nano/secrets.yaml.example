# Copy to nano/secrets.yaml (gitignored) — the Wi-Fi the panel joins; must be the Nano's LAN.
wifi_ssid: "your-ssid"
wifi_password: "your-password"
# The Nano's PhraseKit hotspot (tools/nano.sh hotspot on) — the panel prefers it when in range.
kit_ssid: "PhraseKit"
kit_password: "choose-a-real-one"     # never commit the real value
# A phone hotspot the Nano also knows, for demos without the PhraseKit hotspot.
demo_ssid: "iPhone (2)"
demo_password: "your-hotspot-password"
# The Waveshare panel's device token for the Nano API (any long random string; tools/nano.sh panel
# registers it on the Nano so the panel is a paired device like an iPad).
panel_token: "choose-a-long-random-string"
