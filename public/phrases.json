  "phrases": [
    {
      "key": "p001",
      "version": 1,
      "category": "obstetric_emergency",
      "text": "The umbilical cord is compressed. We must act immediately.",
      "translations": {}
    },
    {
      "key": "p002",
      "version": 1,
      "category": "obstetric_emergency",
      "text": "Do you understand and consent to this emergency procedure?",
      "translations": {}
    },
    {
      "key": "p003",
      "version": 1,
      "category": "obstetric_emergency",
      "text": "Please stay as still as possible for me.",
      "translations": {
        "mi": "E noho puku mai, koa."
      }
    },
    {
      "key": "p004",
      "version": 1,
      "category": "obstetric_emergency",
      "text": "Your baby's heart rate has dropped. This is an emergency.",
      "translations": {}
    },
    {
      "key": "p005",
      "version": 1,
      "category": "obstetric_emergency",
      "text": "We need to perform an emergency caesarean section right now to protect your baby.",
      "translations": {}
    },
    {
      "key": "p006",
      "version": 1,
      "category": "obstetric_emergency",
      "text": "We are going to give you an injection to help you and your baby.",
      "translations": {}
    },
    {
      "key": "p007",
      "version": 1,
      "category": "obstetric_emergency",
      "text": "Try to breathe slowly and deeply.",
      "translations": {
        "mi": "Whakamātauhia ki te whakahā āta ki te whakahā hōhonu hoki."
      }
    },
    {
      "key": "p008",
      "version": 1,
      "category": "obstetric_emergency",
      "text": "The baby is coming now, you need to push.",
      "translations": {}
    },
    {
      "key": "p009",
      "version": 1,
      "category": "obstetric_emergency",
      "text": "We need to monitor your baby's heartbeat continuously.",
      "translations": {}
    },
    {
      "key": "p010",
      "version": 1,
      "category": "obstetric_emergency",
      "text": "Is there anyone you would like us to call?",
      "translations": {}
    }
  ]
